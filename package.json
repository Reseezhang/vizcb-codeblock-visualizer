{
  "name": "vizcb-codeblock-visualizer",
  "description": "Render svg/html/mermaid code blocks as diagram cards + present-files workspace preview (v1.7.4: mermaid 版式后处理 —— 节点标签主/副标题分级、按真实行数重排并垂直居中、节点圆角、边标签去底色、连线统一 1.4px；渲染参数补 CJK 字体栈与字号；只对 flowchart 生效，mermaidPolish=false 可整包回滚。延续 v1.7.3 源码围栏隐藏修复).",
  "version": "1.7.4",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/mermaid-worker.mjs",
    "lib/dom-worker.mjs",
    "lib/svg-dom.mjs",
    "lib/label-metrics.mjs",
    "lib/polish-version.mjs",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reseezhang/vizcb-codeblock-visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/Reseezhang/vizcb-codeblock-visualizer/issues"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "jsdom": "^30.0.1",
    "mermaid": "^11.16.1",
    "svgdom": "^0.1.28"
  }
}
