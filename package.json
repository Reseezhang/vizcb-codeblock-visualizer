{
  "name": "vizcb-codeblock-visualizer",
  "description": "Render svg/html/mermaid code blocks as diagram cards + present-files workspace preview (v1.7.3: 修「源码围栏一直不消失」—— 语言标签类名被 CSS Modules 哈希、横幅对 svg/mermaid 只显示通用标签、turnTail 槽位与消息节点是兄弟，三处宿主假设全不成立导致 hideSourceBlocks 从未生效；改为类名子串 + 正文特征 + 宿主解析结果内容对账 + data-chat-turn 作用域。延续 v1.7.0 骨架占位 + 淡入).",
  "version": "1.7.3",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/mermaid-worker.mjs",
    "lib/dom-worker.mjs",
    "lib/svg-dom.mjs",
    "lib/label-metrics.mjs",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reseezhang/vizcb-codeblock-visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/Reseezhang/vizcb-codeblock-visualizer/issues"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "jsdom": "^30.0.1",
    "mermaid": "^11.16.1",
    "svgdom": "^0.1.28"
  }
}
